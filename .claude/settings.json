{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-prisma-migrate-dev.js",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck-on-edit.js",
            "shell": "bash",
            "timeout": 100,
            "statusMessage": "Type-checking...",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "paddle@claude-community": true
  }
}
