# ModeAlert environment variables — copy to .env and fill in.
# Names only: never commit real values. Everything except DATABASE_URL
# and CRON_SECRET is optional; a feature whose keys are empty is hidden
# or skipped gracefully rather than broken.

# --- Database (Neon Postgres) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Cron ---
CRON_SECRET=

# --- Auth.js ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
ADMIN_EMAILS=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Game data providers ---
RIOT_API_KEY=
BUNGIE_API_KEY=
PUBG_API_KEY=
APEX_API_KEY=

# --- Paddle Billing (docs/06_DECISIONS.md ADR-066) ---
# "sandbox" or "production". Never defaulted — an invalid value throws.
PADDLE_ENVIRONMENT=
# Server-side API key: pdl_sdbx_apikey_… (sandbox) / pdl_live_apikey_… (live).
PADDLE_API_KEY=
# Client-side token: test_… (sandbox) / live_… (live). Safe to expose.
PADDLE_CLIENT_TOKEN=
# Price ids (pri_…) — sandbox and live catalogs have different ids.
PADDLE_PRICE_ID_MONTHLY=
PADDLE_PRICE_ID_YEARLY=
PADDLE_PRICE_ID_LIFETIME=
# Notification destination signing secret (pdl_ntfset_…) — NOT the API key.
PADDLE_WEBHOOK_SECRET=
