generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String?
  emailVerified       DateTime?
  image               String?

  password            String?
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?

  emailOptOut         Boolean        @default(false)
  discordWebhookUrl   String?

  // Language for notifications (email/Discord). Nullable, not
  // defaulted to "en": null means "never chosen", which is a real
  // distinction from "chose English" — it lets the app adopt a
  // different fallback later without mistaking existing rows for a
  // deliberate choice. Browsing language stays cookie-driven (see
  // proxy.ts); this is only for messages sent to the user when
  // there's no browser to read a cookie from.
  locale              String?

  onboardedAt         DateTime?

  plan                       String    @default("FREE")
  lemonSqueezyCustomerId     String?
  lemonSqueezySubscriptionId String?   @unique
  subscriptionStatus         String?
  subscriptionRenewsAt       DateTime?

  accounts            Account[]
  sessions            Session[]

  watchlists          Watchlist[]
  gameWatchlists      GameWatchlist[]
  notifications       Notification[]
  analyticsEvents     AnalyticsEvent[]
  feedback            Feedback[]
  apiKeys             ApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Game {
  id              String      @id
  name            String
  slug            String      @unique
  logo            String
  color           String

  shortName       String
  supportedEvents Int
  activeUsers     String
  featured        Boolean

  events          Event[]
  gameWatchlists  GameWatchlist[]
}

model Event {
  id            String         @id
  gameId        String
  source        String

  title         String
  description   String?

  // When a provider's description is entirely ModeAlert-authored (no
  // raw third-party text mixed in), it also sets these two so the
  // description can be translated at display time — `description`
  // itself stays the guaranteed English fallback (used as-is when a
  // provider mixes in real third-party text, e.g. a Bungie milestone
  // blurb or a Helldivers briefing, which can never be translated).
  // See docs/06_DECISIONS.md ADR-054 "Faz 3".
  descriptionKey    String?
  descriptionParams Json?

  slug          String?        @unique
  status        String
  category      String         @default("PLAYABLE")
  isLimitedTime Boolean        @default(true)
  seriesKey     String?

  trackedUsers  Int
  lastChecked   String

  game          Game           @relation(fields: [gameId], references: [id])

  watchlists    Watchlist[]
  notifications Notification[]

  history       EventHistory[]
  changes       EventChange[]

  @@index([source])
  @@index([seriesKey])
  @@index([gameId])
  @@index([status])
}

model EventHistory {
  id          String   @id @default(cuid())

  eventId     String

  status      String

  startedAt   DateTime

  endedAt     DateTime?

  createdAt   DateTime @default(now())

 event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])

  @@index([startedAt])
}

model EventChange {
  id        String   @id @default(cuid())

  eventId   String

  field     String

  oldValue  String?

  newValue  String?

  changedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])

  @@index([changedAt])
}

model ProviderHealthCheck {
  id         String   @id @default(cuid())

  providerId String

  healthy    Boolean

  latencyMs  Int?

  error      String?

  checkedAt  DateTime @default(now())

  @@index([providerId])

  @@index([checkedAt])
}

model NotificationFailure {
  id        String   @id @default(cuid())

  userId    String
  eventId   String

  channel   String

  error     String

  createdAt DateTime @default(now())

  @@index([userId])

  @@index([createdAt])
}

// Fixed-window rate limiting, Postgres-backed to match every other
// piece of state in this app (no Redis/edge-KV dependency added just
// for this). One row per attempt; `checkRateLimit` counts rows for a
// `key` newer than the window start. Volume is low enough (auth
// endpoints only) that this comfortably outperforms the cost of a new
// piece of infrastructure — see docs/06_DECISIONS.md ADR-045.
model RateLimitHit {
  id        String   @id @default(cuid())

  key       String

  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// First-party, no-cookie funnel tracking — see docs/06_DECISIONS.md
// ADR-046. Deliberately scoped to signed-in users only (no anonymous/
// pre-signup tracking, no third-party script) so it stays consistent
// with the privacy policy's "no tracking pixels, no cross-site
// tracking" promise. `detail` is a small free-text tag (e.g. which
// onboarding step), not a JSON blob — kept simple on purpose.
model AnalyticsEvent {
  id        String   @id @default(cuid())

  userId    String
  name      String
  detail    String?

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([name, createdAt])
  @@index([userId])
}

// Deliberately not linked to a user or any per-visitor identifier —
// no cookie, no session id, nothing that could later be joined back
// to a person. Just a raw count of an anonymous page view, so
// landing->signup conversion can be estimated without tracking any
// individual visitor. See docs/06_DECISIONS.md ADR-056.
model AnonymousFunnelEvent {
  id        String   @id @default(cuid())

  name      String

  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

model Watchlist {
  id        String   @id @default(cuid())

  userId    String
  eventId   String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([eventId])
}

// Premium-only "follow the whole game" — see ADR-051. Separate table
// from Watchlist (not a nullable eventId on it) so the free-plan
// per-event limit logic never has to reason about rows with no event.
model GameWatchlist {
  id        String   @id @default(cuid())

  userId    String
  gameId    String

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
  @@index([gameId])
}

model Notification {
  id         String   @id @default(cuid())

  userId     String
  eventId    String

  title      String
  message    String

  channel    String

  read       Boolean

  // Null = not reported. Set the one time a user flags this specific
  // notification as wrong (e.g. the event it announced wasn't really
  // live/didn't happen as described) — real, first-party feedback,
  // not an inferred/guessed signal.
  falsePositiveReportedAt DateTime?

  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event    @relation(fields: [eventId], references: [id])

  @@index([userId, createdAt])
}

// In-app feedback widget (navbar, signed-in users only) — the gap
// this closed: before this, the only way to reach Deniz was finding
// an email address buried in the ToS. No admin reply/status field on
// purpose — this is a one-way inbox, not a support-ticket system.
model Feedback {
  id        String   @id @default(cuid())

  userId    String

  message   String

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// Public read API (developer product). keyHash is a SHA-256 digest of
// the raw key — the raw value is shown to the user exactly once at
// creation and never stored, same principle as a password hash but
// deterministic (SHA-256, not bcrypt) since every request needs a
// fast, direct lookup by hash, not a per-request comparison. keyPrefix
// (the raw key's first 12 chars) is stored in the clear so a user can
// tell their keys apart in a list without ModeAlert ever holding the
// full value.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String

  name       String
  keyHash    String    @unique
  keyPrefix  String

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}