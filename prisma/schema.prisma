generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String?
  emailVerified       DateTime?
  image               String?

  password            String?
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?

  emailOptOut         Boolean        @default(false)

  plan                       String    @default("FREE")
  lemonSqueezyCustomerId     String?
  lemonSqueezySubscriptionId String?   @unique
  subscriptionStatus         String?
  subscriptionRenewsAt       DateTime?

  accounts            Account[]
  sessions            Session[]

  watchlists          Watchlist[]
  notifications       Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Game {
  id              String      @id
  name            String
  slug            String      @unique
  logo            String
  color           String

  shortName       String
  supportedEvents Int
  activeUsers     String
  featured        Boolean

  events          Event[]
}

model Event {
  id            String         @id
  gameId        String
  source        String

  title         String
  description   String?
  slug          String?        @unique
  status        String
  category      String         @default("PLAYABLE")
  isLimitedTime Boolean        @default(true)
  seriesKey     String?

  trackedUsers  Int
  lastChecked   String

  game          Game           @relation(fields: [gameId], references: [id])

  watchlists    Watchlist[]
  notifications Notification[]

  history       EventHistory[]
  changes       EventChange[]

  @@index([source])
  @@index([seriesKey])
  @@index([gameId])
  @@index([status])
}

model EventHistory {
  id          String   @id @default(cuid())

  eventId     String

  status      String

  startedAt   DateTime

  endedAt     DateTime?

  createdAt   DateTime @default(now())

 event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])

  @@index([startedAt])
}

model EventChange {
  id        String   @id @default(cuid())

  eventId   String

  field     String

  oldValue  String?

  newValue  String?

  changedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])

  @@index([changedAt])
}

model ProviderHealthCheck {
  id         String   @id @default(cuid())

  providerId String

  healthy    Boolean

  latencyMs  Int?

  error      String?

  checkedAt  DateTime @default(now())

  @@index([providerId])

  @@index([checkedAt])
}

model NotificationFailure {
  id        String   @id @default(cuid())

  userId    String
  eventId   String

  channel   String

  error     String

  createdAt DateTime @default(now())

  @@index([userId])

  @@index([createdAt])
}

// Fixed-window rate limiting, Postgres-backed to match every other
// piece of state in this app (no Redis/edge-KV dependency added just
// for this). One row per attempt; `checkRateLimit` counts rows for a
// `key` newer than the window start. Volume is low enough (auth
// endpoints only) that this comfortably outperforms the cost of a new
// piece of infrastructure — see docs/06_DECISIONS.md ADR-045.
model RateLimitHit {
  id        String   @id @default(cuid())

  key       String

  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Watchlist {
  id        String   @id @default(cuid())

  userId    String
  eventId   String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([eventId])
}

model Notification {
  id         String   @id @default(cuid())

  userId     String
  eventId    String

  title      String
  message    String

  channel    String

  read       Boolean

  // Null = not reported. Set the one time a user flags this specific
  // notification as wrong (e.g. the event it announced wasn't really
  // live/didn't happen as described) — real, first-party feedback,
  // not an inferred/guessed signal.
  falsePositiveReportedAt DateTime?

  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event    @relation(fields: [eventId], references: [id])

  @@index([userId, createdAt])
}